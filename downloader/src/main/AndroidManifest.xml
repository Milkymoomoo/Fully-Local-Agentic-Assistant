<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="@string/app_name" android:icon="@android:drawable/stat_sys_download"
        android:allowBackup="false" android:theme="@android:style/Theme.DeviceDefault.DayNight">
        <activity android:name=".DownloaderActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".FilesProvider" android:authorities="app.belle.downloader.files"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
